# Shared runtime configuration
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_EXTERNAL_SERVICES=true
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5

# One shared MySQL container/database
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=ecwf_db
MYSQL_USER=ecwf_user
MYSQL_PASSWORD=ecwf_password
DATABASE_URL=mysql+pymysql://ecwf_user:ecwf_password@db:3306/ecwf_db

# Shared service-to-service credential
INTERNAL_API_KEY=change_me_shared_internal_api_key
